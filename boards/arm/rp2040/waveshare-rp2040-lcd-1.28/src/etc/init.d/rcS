#include <nuttx/config.h>

/* This script "rcS" is executed after the rc.sysinit script.
 *
 * W5 startup orchestration:
 *   - resetcause bootloader  -> ENTER_BOOTLOADER (SCRATCH magic): run
 *     fastbootd with no timeout so it stays resident and the host can
 *     update the AP partition over USB at any time.
 *   - otherwise              -> normal boot: fastbootd <wait_ms> returns
 *     after wait_ms with no client connected (or right after a connected
 *     client disconnects); only once it returns does "boot" chain into
 *     the AP image via board_boot_image() (BOARDIOC_BOOT_IMAGE).
 */

#ifdef CONFIG_SYSTEM_FASTBOOTD
if resetcause bootloader
then
  fastbootd &
else
  fastbootd 2000 &
#ifdef CONFIG_BOARDCTL_BOOT_IMAGE
  sleep 3
  boot /dev/ap0 0x0
#endif
fi
#elif defined(CONFIG_BOARDCTL_BOOT_IMAGE)
boot /dev/ap0 0x0
#endif
