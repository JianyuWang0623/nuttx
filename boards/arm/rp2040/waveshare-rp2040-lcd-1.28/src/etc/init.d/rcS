#include <nuttx/config.h>

/* This script "rcS" is executed after the rc.sysinit script.
 *
 * W5 startup orchestration:
 *   - resetcause bootloader  -> ENTER_BOOTLOADER (SCRATCH magic): run
 *     fastbootd with no timeout so it stays resident and the host can
 *     update the AP partition over USB at any time.
 *   - otherwise              -> normal boot: fastbootd <wait_ms> runs in
 *     the foreground; if a client connects before the timeout, fastbootd
 *     stays resident until the host triggers a reboot or boot via the
 *     oem shell command -- it does not return on client disconnect;
 *     if no client connects within wait_ms, fastbootd returns and boot
 *     chains to the AP image via board_boot_image();  if boot returns
 *     (AP image missing or corrupt), reboot so the next cold boot opens
 *     a fresh fastbootd window for recovery without requiring physical
 *     BOOTSEL.
 *
 * The resetcause output includes a trailing newline, so string comparison
 * is unreliable.  Instead we redirect the output to a tmpfs file and use
 * cmp against a pre-built reference that was generated with the same bytes.
 */

#ifdef CONFIG_SYSTEM_FASTBOOTD
resetcause > /tmp/rc.txt
if cmp /tmp/rc.txt /etc/rc.bootloader
then
  fastbootd &
else
  fastbootd 2000
#ifdef CONFIG_BOARDCTL_BOOT_IMAGE
  set +e
  boot /dev/ap0 0x0
  reboot
#endif
fi
#elif defined(CONFIG_BOARDCTL_BOOT_IMAGE)
boot /dev/ap0 0x0
#endif
